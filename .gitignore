# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Rust build artifacts
/target/

# C extensions (including the extension module built by `maturin develop`)
*.so
*.pyd
*.dylib

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage/.*
.cache
nosetests.xml
coverage.xml
*,cover
.pytest_cache
# Coverage of the Rust code (cargo-llvm-cov)
*.profraw
*.profdata
*.lcov
/coverage-report/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# IPython
.ipynb_checkpoints
Untitled.ipynb

